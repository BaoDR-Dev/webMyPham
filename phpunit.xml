<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         stopOnFailure="false">

    <testsuites>
        <testsuite name="WhiteBox Tests – WEBBANHANG">
            <file>tests/LoginTest.php</file>
            <file>tests/RegisterTest.php</file>
            <file>tests/AddCartTest.php</file>
            <file>tests/CheckoutTest.php</file>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>app/models</directory>
            <directory>app/controllers</directory>
        </include>
        <exclude>
            <directory>app/views</directory>
            <directory>app/helpers</directory>
            <directory>vendor</directory>
        </exclude>
    </source>

    <coverage>
        <report>
            <html outputDirectory="coverage/html" lowUpperBound="50" highLowerBound="90"/>
            <clover outputFile="coverage/clover.xml"/>
        </report>
    </coverage>

    <php>
        <ini name="error_reporting" value="-1"/>
        <ini name="display_errors"  value="1"/>
        <env name="BASE_URL"        value=""/>
    </php>
</phpunit>
